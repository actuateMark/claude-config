{% macro status_badge(status) -%}
<span class="badge badge-{{ status }}">{{ status | upper }}</span>
{%- endmacro %}

{% macro format_value(value, unit) -%}
{%- if value is none -%}—
{%- elif value is mapping -%}
{%- if value | length == 0 -%}{} (empty)
{%- else -%}
{{ value | length }} items <span class="facet-preview">{% set ns = namespace(n=0) %}{% for k, v in value | dictsort(by="value") | reverse %}{% if ns.n < 3 %}<code>{{ k }}={{ v }}</code>{% if not loop.last and ns.n < 2 %}, {% endif %}{% set ns.n = ns.n + 1 %}{% endif %}{% endfor %}{% if value | length > 3 %}, …{% endif %}</span>
{%- endif -%}
{%- else -%}{{ value }}{% if unit %} {{ unit }}{% endif %}
{%- endif -%}
{%- endmacro %}

{# Full breakdown of a FACET dict: every key with today's value, prior-day
   value, delta, and a 'new'/'gone' flag. Renders as a sortable table in the
   drawer so 'red because 15 items' becomes actionable. #}
{% macro facet_breakdown(value, prior_value) -%}
{% if value is mapping and value | length > 0 -%}
{%- set today_keys = value.keys() | list -%}
{# Only treat prior as comparable when it's also a mapping. If prior was a
   scalar (e.g. signal shape changed from count → FACET), don't flag every
   key as 'gone' — there's just no prior dict to diff against. #}
{%- set has_prior_dict = prior_value is mapping -%}
{%- set prior_keys = prior_value.keys() | list if has_prior_dict else [] -%}
{%- set all_keys = (today_keys + prior_keys) | unique | list -%}
<table class="facet-table">
  <thead>
    <tr>
      <th>Key</th>
      <th class="num">Today</th>
      <th class="num">Prior</th>
      <th class="num">Δ</th>
      <th>Flag</th>
    </tr>
  </thead>
  <tbody>
    {%- set rows = [] -%}
    {%- for k in all_keys -%}
      {%- set t = value.get(k) -%}
      {%- set p = prior_value.get(k) if has_prior_dict else none -%}
      {%- set t_num = t if t is number else 0 -%}
      {%- set p_num = p if p is number else 0 -%}
      {%- set delta = t_num - p_num -%}
      {# is_new / is_gone only meaningful when we have a prior dict to compare.
         is_new: in today but not in prior (only flag if has_prior_dict).
         is_gone: in prior but not in today (key dropped off). #}
      {%- set is_new = has_prior_dict and t is not none and p is none -%}
      {%- set is_gone = has_prior_dict and t is none and p is not none -%}
      {# Sort key (first elem) is always numeric — avoids None-vs-int errors. #}
      {%- set _ = rows.append((t_num, k, t, p, delta, is_new, is_gone)) -%}
    {%- endfor -%}
    {%- for t_sort, k, t, p, delta, is_new, is_gone in rows | sort(attribute=0, reverse=true) -%}
    <tr class="{% if is_new %}facet-new{% elif is_gone %}facet-gone{% endif %}">
      <td><code>{{ k }}</code></td>
      <td class="num">{% if t is none %}—{% else %}{{ t }}{% endif %}</td>
      <td class="num">{% if p is none %}—{% else %}{{ p }}{% endif %}</td>
      <td class="num facet-delta {% if delta > 0 %}delta-up{% elif delta < 0 %}delta-down{% endif %}">{% if t is none or p is none %}—{% else %}{% if delta > 0 %}+{% endif %}{{ delta }}{% endif %}</td>
      <td>{% if is_new %}<span class="facet-new-flag">✨ new</span>{% elif is_gone %}<span class="facet-gone-flag">⊘ gone</span>{% endif %}</td>
    </tr>
    {%- endfor %}
  </tbody>
</table>
{%- endif -%}
{%- endmacro %}

{# Tiny inline sparkline from history rows. For scalar signals only. #}
{% macro mini_sparkline(history, max_points=20) -%}
{% set numeric = history | selectattr("value", "number") | list %}
{% if numeric | length >= 2 %}
{%- set values = numeric[-max_points:] | map(attribute="value") | list -%}
{%- set vmax = values | max -%}
{%- set vmin = values | min -%}
{%- set vrange = (vmax - vmin) if vmax > vmin else 1 -%}
<svg class="mini-spark" viewBox="0 0 100 24" preserveAspectRatio="none" aria-label="trailing values">
  <polyline points="
    {%- for v in values -%}
    {{ '%.2f' % (loop.index0 * 100 / (values | length - 1)) }},{{ '%.2f' % (22 - ((v - vmin) / vrange * 20)) }}
    {% endfor -%}
  " />
</svg>
<span class="spark-meta">min {{ vmin }} · max {{ vmax }} · n {{ values | length }}</span>
{% endif %}
{%- endmacro %}

{% macro format_thresholds(t) -%}
{% if t %}
{% for k, v in t.items() %}<code class="threshold">{{ k }}: {{ v }}</code>{% if not loop.last %} {% endif %}{% endfor %}
{% else %}—{% endif %}
{%- endmacro %}

{# Compact grid row using <details> for inline expand. Summary is the scannable line;
   drawer holds description, thresholds, source query, KB link, regressions. #}
{% macro data_source_badge(ev) -%}
{% if ev.data_source == "live" %}<span class="src-badge src-live" title="Fresh observation from this run">live</span>
{% elif ev.data_source == "sink_recent" %}<span class="src-badge src-sink-recent" title="From sink ({{ '%.1f' % ev.freshness_hours }}h old)">hist {{ '%.0f' % ev.freshness_hours }}h</span>
{% elif ev.data_source == "sink_stale" %}<span class="src-badge src-sink-stale" title="Stale: {{ '%.1f' % ev.freshness_hours }}h old, past freshness threshold">stale {{ '%.0f' % ev.freshness_hours }}h</span>
{% elif ev.data_source == "none" %}<span class="src-badge src-none" title="No observation and no sink history">no data</span>
{% endif %}
{%- endmacro %}

{% macro signal_item(ev) -%}
<details class="signal-item signal-{{ ev.status }} src-{{ ev.data_source | replace('_', '-') }}"{% if ev.status == 'red' %} open{% endif %}>
  <summary class="signal-summary">
    <span class="sig-col sig-col-status">{{ status_badge(ev.status) }}</span>
    <span class="sig-col sig-col-id"><code>{{ ev.signal_id }}</code> {{ data_source_badge(ev) }}</span>
    <span class="sig-col sig-col-value">{{ format_value(ev.value, ev.unit) }}</span>
    <span class="sig-col sig-col-baseline">{% if ev.baseline is not none %}{{ ev.baseline }}{% else %}—{% endif %}</span>
    <span class="sig-col sig-col-regressions">{% if ev.regressions %}<span class="regression-flag">⚠ {{ ev.regressions | join(", ") }}</span>{% endif %}</span>
    <span class="sig-col sig-col-chevron" aria-hidden="true">▸</span>
  </summary>
  <div class="signal-drawer">
    {% if ev.description %}
    <div class="drawer-section">
      <div class="drawer-label">Description</div>
      <div class="drawer-body">{{ ev.description }}</div>
    </div>
    {% endif %}
    <div class="drawer-grid">
      <div class="drawer-cell">
        <div class="drawer-label">Data source</div>
        <div class="drawer-body">
          {{ data_source_badge(ev) }}
          {% if ev.last_observed_at %}<br><small>last observed: <code>{{ ev.last_observed_at }}</code>{% if ev.freshness_hours is not none %} ({{ '%.1f' % ev.freshness_hours }}h ago){% endif %}</small>{% endif %}
          {% if ev.history %}<br><small>history: {{ ev.history | length }} sink rows in trailing 7d window</small>{% endif %}
        </div>
      </div>
      <div class="drawer-cell">
        <div class="drawer-label">Thresholds</div>
        <div class="drawer-body">{{ format_thresholds(ev.thresholds) }}</div>
      </div>
      {% if ev.paired_with %}
      <div class="drawer-cell">
        <div class="drawer-label">Paired with</div>
        <div class="drawer-body"><code>{{ ev.paired_with }}</code></div>
      </div>
      {% endif %}
      {% if ev.source %}
      <div class="drawer-cell">
        <div class="drawer-label">Source</div>
        <div class="drawer-body"><code>{{ ev.source }}</code></div>
      </div>
      {% endif %}
      {% if ev.would_have_caught %}
      <div class="drawer-cell drawer-cell-wide">
        <div class="drawer-label">Would have caught</div>
        <div class="drawer-body">{{ ev.would_have_caught }}</div>
      </div>
      {% endif %}
    </div>
    {% if ev.query %}
    <div class="drawer-section">
      <div class="drawer-label">Query</div>
      <pre class="drawer-query"><code>{{ ev.query }}</code></pre>
    </div>
    {% endif %}
    {% if ev.kb_link %}
    <div class="drawer-section">
      <div class="drawer-label">Rationale</div>
      <div class="drawer-body"><a href="{{ ev.kb_link }}">{{ ev.kb_link }}</a></div>
    </div>
    {% endif %}
    {% if ev.notes %}
    <div class="drawer-section">
      <div class="drawer-label">Notes</div>
      <div class="drawer-body">{{ ev.notes }}</div>
    </div>
    {% endif %}
    {# FACET breakdown — only meaningful when value is a dict #}
    {% if ev.value is mapping and ev.value | length > 0 %}
    <div class="drawer-section">
      <div class="drawer-label">Full breakdown ({{ ev.value | length }} keys)</div>
      <div class="drawer-body">{{ facet_breakdown(ev.value, ev.prior_value) }}</div>
    </div>
    {% elif ev.history and ev.history | length >= 2 %}
    <div class="drawer-section">
      <div class="drawer-label">Trailing window</div>
      <div class="drawer-body">{{ mini_sparkline(ev.history) }}</div>
    </div>
    {% endif %}
    {# Today vs prior, for scalar values only — dict diffs live in the breakdown above #}
    {% if ev.prior_value is not none and ev.prior_value is not mapping and ev.value is not mapping %}
    <div class="drawer-section">
      <div class="drawer-label">Prior-day comparison</div>
      <div class="drawer-body">today <code>{{ ev.value }}</code> · prior <code>{{ ev.prior_value }}</code>
        {% if ev.value is number and ev.prior_value is number %}
          {% set delta = ev.value - ev.prior_value %}
          · Δ <span class="facet-delta {% if delta > 0 %}delta-up{% elif delta < 0 %}delta-down{% endif %}">{% if delta > 0 %}+{% endif %}{{ delta }}</span>
        {% endif %}
      </div>
    </div>
    {% endif %}
  </div>
</details>
{%- endmacro %}

{# Site-wide nav linking to the other surfaces on this box. Mirrors the
   `<nav class=statusnav>` block on the / status page (see gen-status-page.sh).
   Uses absolute paths because each surface (/, /dashboard/, /app/, /logs/, …)
   is a separate Caddy handle. `active` is one of: home, kb, ask, today, jira,
   repos, metrics, ops, admin — for dashboard pages it's always "ops". #}
{% macro site_nav(active="ops") -%}
<nav class="site-nav" aria-label="Box navigation">
  <span class="site-nav-label">navigate:</span>
  <a class="site-nav-link {% if active == 'home' %}site-nav-active{% endif %}" href="/app/">home</a>
  <span class="site-nav-sep">·</span>
  <a class="site-nav-link {% if active == 'kb' %}site-nav-active{% endif %}" href="/app/kb/">kb</a>
  <span class="site-nav-sep">·</span>
  <a class="site-nav-link {% if active == 'ask' %}site-nav-active{% endif %}" href="/app/kb/query">ask</a>
  <span class="site-nav-sep">·</span>
  <a class="site-nav-link {% if active == 'today' %}site-nav-active{% endif %}" href="/app/today/">today</a>
  <span class="site-nav-sep">·</span>
  <a class="site-nav-link {% if active == 'jira' %}site-nav-active{% endif %}" href="/app/jira/">jira</a>
  <span class="site-nav-sep">·</span>
  <a class="site-nav-link {% if active == 'repos' %}site-nav-active{% endif %}" href="/app/repos/">repos</a>
  <span class="site-nav-sep">·</span>
  <a class="site-nav-link {% if active == 'metrics' %}site-nav-active{% endif %}" href="/app/metrics/">metrics</a>
  <span class="site-nav-sep">·</span>
  <a class="site-nav-link {% if active == 'ops' %}site-nav-active{% endif %}" href="/dashboard/">ops</a>
  <span class="site-nav-sep">·</span>
  <a class="site-nav-link {% if active == 'admin' %}site-nav-active{% endif %}" href="/app/admin/">admin</a>
  <span class="site-nav-sep">·</span>
  <a class="site-nav-link" href="/logs/">logs</a>
  <span class="site-nav-sep">·</span>
  <a class="site-nav-link" href="/">status</a>
</nav>
{%- endmacro %}

{# Top-of-page tab nav. `active` is one of: overview, trends, regressions, component.
   `prefix` is "" for top-level pages and "../" for /components/<name>.html. #}
{% macro nav_tabs(active, prefix="", regressions_count=0) -%}
<nav class="page-tabs" aria-label="Dashboard pages">
  <a class="page-tab {% if active == 'overview' %}page-tab-active{% endif %}" href="{{ prefix }}index.html">Overview</a>
  <a class="page-tab {% if active == 'trends' %}page-tab-active{% endif %}" href="{{ prefix }}trends.html">Trends</a>
  <a class="page-tab {% if active == 'regressions' %}page-tab-active{% endif %}" href="{{ prefix }}regressions.html">Regressions{% if regressions_count %} <span class="page-tab-count">({{ regressions_count }})</span>{% endif %}</a>
</nav>
{%- endmacro %}

{# Trend chart — bigger inline SVG line chart for the Trends section.
   Driven by pre-computed dict from build_trend_data() in render.py. #}
{% macro trend_chart(t) -%}
<article class="trend-card trend-{{ t.status }}" id="trend-{{ t.signal_id }}">
  <header class="trend-head">
    <span class="trend-status">{{ status_badge(t.status) }}</span>
    <a class="trend-name" href="components/{{ t.component }}.html#{{ t.signal_id }}"><code>{{ t.signal_id }}</code></a>
    <span class="trend-current">{% if t.current_value is not none %}{{ t.current_value }}{% if t.unit %} {{ t.unit }}{% endif %}{% else %}—{% endif %}</span>
  </header>
  <svg class="trend-svg" viewBox="{{ t.viewbox }}" preserveAspectRatio="none" role="img" aria-label="trend for {{ t.signal_id }}">
    {# Plot frame: y-axis + x-axis baseline #}
    <line class="trend-axis" x1="{{ t.y_axis_x }}" y1="{{ t.plot_box.T }}" x2="{{ t.y_axis_x }}" y2="{{ t.x_axis_y }}" />
    <line class="trend-axis" x1="{{ t.y_axis_x }}" y1="{{ t.x_axis_y }}" x2="{{ t.x_axis_x_end }}" y2="{{ t.x_axis_y }}" />
    {# Y-axis labels: min and max of observed data #}
    <text class="trend-y-label" x="{{ t.y_axis_x - 4 }}" y="{{ t.plot_box.T + 4 }}" text-anchor="end">{{ t.ymax_label }}</text>
    <text class="trend-y-label" x="{{ t.y_axis_x - 4 }}" y="{{ t.x_axis_y }}" text-anchor="end">{{ t.ymin_label }}</text>
    {# Threshold guide-lines #}
    {% for g in t.guides %}
    <line class="trend-guide trend-guide-{{ g.color }}" x1="{{ t.y_axis_x }}" y1="{{ '%.2f' % g.y }}" x2="{{ t.x_axis_x_end }}" y2="{{ '%.2f' % g.y }}" />
    <text class="trend-guide-label trend-guide-{{ g.color }}" x="{{ t.x_axis_x_end - 2 }}" y="{{ '%.2f' % (g.y - 2) }}" text-anchor="end">{{ g.label }} {{ g.value }}</text>
    {% endfor %}
    {# Data line #}
    <path class="trend-line" d="{{ t.path_d }}" />
    {# Point markers #}
    {% for p in t.points %}
    <circle class="trend-point" cx="{{ '%.2f' % p.x }}" cy="{{ '%.2f' % p.y }}" r="2"><title>{{ p.ts }}: {{ p.value }}</title></circle>
    {% endfor %}
    {# X-axis range labels #}
    <text class="trend-x-label" x="{{ t.y_axis_x }}" y="{{ t.plot_box.H - 6 }}" text-anchor="start">{{ t.xmin_label }}</text>
    <text class="trend-x-label" x="{{ t.x_axis_x_end }}" y="{{ t.plot_box.H - 6 }}" text-anchor="end">{{ t.xmax_label }}</text>
  </svg>
  <footer class="trend-foot">
    <span>{{ t.n_points }} pts</span>
    {% if t.guides %}<span class="trend-foot-sep">·</span><span>thresholds shown as dashed lines</span>{% endif %}
  </footer>
</article>
{%- endmacro %}

{# Header row with column labels — sits at the top of each signal-list block to mimic table headers #}
{% macro signal_list_header() -%}
<div class="signal-list-header">
  <span class="sig-col sig-col-status">Status</span>
  <span class="sig-col sig-col-id">Signal</span>
  <span class="sig-col sig-col-value">Value</span>
  <span class="sig-col sig-col-baseline">Baseline</span>
  <span class="sig-col sig-col-regressions">Regressions</span>
  <span class="sig-col sig-col-chevron"></span>
</div>
{%- endmacro %}

{# --- Hero cards for the index page --- #}

{# Card 1: Status heat-grid. One chip per evaluated signal, colored by current status.
   Until per-day history is available, each chip shows only today's state. #}
{% macro hero_heatgrid(by_component) -%}
<div class="hero-heatgrid">
  {% for component, evs in by_component.items() %}
  <div class="heat-row">
    <div class="heat-row-label"><a href="components/{{ component }}.html">{{ component }}</a></div>
    <div class="heat-row-chips">
      {% for ev in evs %}
      <a class="heat-chip heat-{{ ev.status }}" href="components/{{ component }}.html#{{ ev.signal_id }}" title="{{ ev.signal_id }} ({{ ev.status }})">&nbsp;</a>
      {% endfor %}
    </div>
  </div>
  {% endfor %}
</div>
{%- endmacro %}

{# Card 2: Top regressions today (ranked list of evaluations with regressions). #}
{% macro hero_regressions(regressions) -%}
{% if regressions %}
<ol class="hero-regression-list">
  {% for ev in regressions %}
  <li class="hero-regression-item hero-regression-{{ ev.status }}">
    <div class="hero-regression-head">
      {{ status_badge(ev.status) }}
      <code>{{ ev.signal_id }}</code>
      <span class="hero-regression-component">({{ ev.component }})</span>
    </div>
    <div class="hero-regression-body">
      <span class="hero-regression-rules">{{ ev.regressions | join(", ") }}</span>
      <span class="hero-regression-sep">·</span>
      <span>value={{ ev.value }}</span>
      {% if ev.baseline is not none %}<span>baseline={{ ev.baseline }}</span>{% endif %}
    </div>
  </li>
  {% endfor %}
</ol>
{% else %}
<p class="empty">No regressions detected this run. 🎉</p>
{% endif %}
{%- endmacro %}

{# Card 3: Overall summary — status counts + component breakdown. #}
{% macro hero_summary(evaluations, by_component, overall) -%}
<div class="hero-summary">
  <div class="hero-summary-overall">
    Overall: {{ status_badge(overall) }}
    <span class="hero-summary-total">{{ evaluations | length }} signals evaluated</span>
  </div>
  <div class="hero-summary-counts">
    {% set count_green = evaluations | selectattr("status", "equalto", "green") | list | length %}
    {% set count_yellow = evaluations | selectattr("status", "equalto", "yellow") | list | length %}
    {% set count_red = evaluations | selectattr("status", "equalto", "red") | list | length %}
    {% set count_error = evaluations | selectattr("status", "equalto", "error") | list | length %}
    {% set count_info = evaluations | selectattr("status", "equalto", "informational") | list | length %}
    <span class="hero-count hero-count-green">{{ count_green }} green</span>
    <span class="hero-count hero-count-yellow">{{ count_yellow }} yellow</span>
    <span class="hero-count hero-count-red">{{ count_red }} red</span>
    {% if count_error %}<span class="hero-count hero-count-error">{{ count_error }} error</span>{% endif %}
    {% if count_info %}<span class="hero-count hero-count-info">{{ count_info }} info</span>{% endif %}
  </div>
  <table class="hero-summary-table">
    <thead><tr><th>Component</th><th>Signals</th><th>Status mix</th></tr></thead>
    <tbody>
      {% for component, evs in by_component.items() %}
      <tr>
        <td><a href="components/{{ component }}.html">{{ component }}</a></td>
        <td>{{ evs | length }}</td>
        <td class="hero-summary-mix">
          {% for ev in evs %}<span class="mix-dot mix-{{ ev.status }}" title="{{ ev.signal_id }}"></span>{% endfor %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{%- endmacro %}
