<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Trends — {{ snapshot_date }}</title>
<style>{{ css }}</style>
</head>
<body>
{% from "macros.j2" import nav_tabs, trend_chart, status_badge, site_nav %}

{{ site_nav("ops") }}

<header>
  <h1>Trends</h1>
  <p class="meta">
    Snapshot: <code>{{ snapshot_time }}</code>
    &middot; Date: <code>{{ snapshot_date }}</code>
    &middot; Overall: {{ status_badge(overall) }}
  </p>
</header>

{{ nav_tabs("trends", regressions_count=regressions_count) }}

<section class="trends-section">
  {% if trends_by_component %}
    {% set total_trends = (trends_by_component.values() | map('length') | sum) %}
    <p class="trends-meta">{{ total_trends }} signals with ≥3 numeric observations in the trailing 7-day window. Threshold lines (where defined) are dashed yellow / red.</p>
    {% for component, charts in trends_by_component.items() %}
    <article class="trend-component-block">
      <h3><a href="components/{{ component }}.html">{{ component }}</a> <small class="component-count">({{ charts | length }})</small></h3>
      <div class="trend-grid">
        {% for t in charts %}
        {{ trend_chart(t) }}
        {% endfor %}
      </div>
    </article>
    {% endfor %}
  {% else %}
    <p class="empty">No signals have enough numeric history yet. Charts populate as the dashboard cron accumulates points (≥3 per signal needed).</p>
  {% endif %}
  {% if trend_skipped %}
  <details class="trends-skipped">
    <summary>{{ trend_skipped | length }} signals skipped (insufficient history)</summary>
    <p>{% for sid in trend_skipped %}<code>{{ sid }}</code>{% if not loop.last %} · {% endif %}{% endfor %}</p>
  </details>
  {% endif %}
</section>

<footer>
  <p>Generated by <code>/dashboard-check</code> &middot; data sourced from <code>~/Documents/worklog/dashboard/sink/observations.jsonl</code> on the Firebat.</p>
</footer>
</body>
</html>
